FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    pkg-config \
    libglfw3-dev \
    libgl1-mesa-dev \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libeigen3-dev \
    libimgui-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY . /workspace/src/

WORKDIR /workspace/src/LinuxEditionSpaceClibrator

RUN if [ -f "../.gitmodules" ]; then \
        cd .. && git submodule update --init --recursive || true; \
    fi

CMD ["/bin/bash", "-c", "cd /workspace/src/LinuxEditionSpaceClibrator && ./scripts/build.sh"]
